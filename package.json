{
  "name": "dbweb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" run dev",
    "dev:server": "pnpm --filter @dbweb/server run dev",
    "dev:web": "pnpm --filter @dbweb/web run dev",
    "serve": "./scripts/serve.sh",
    "app:install": "./scripts/install-app.sh",
    "app:start": "./scripts/app.sh start",
    "app:stop": "./scripts/app.sh stop",
    "app:restart": "./scripts/app.sh restart",
    "app:status": "./scripts/app.sh status",
    "app:logs": "./scripts/app.sh logs",
    "app:launcher": "./scripts/make-launcher.sh",
    "app:uninstall": "./scripts/uninstall-app.sh",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": "^20 || ^22"
  }
}
